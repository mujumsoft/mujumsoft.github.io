{{<html}}
{{$main}}

<div class="page">
    <div id="home">
        <nav class="language-switcher" aria-label="Choose language">
            {{#site.language_options}}
            <a class="language-option" href="{{baseUrl}}{{url}}" lang="{{code}}" aria-label="{{label}}" title="{{label}}"><span class="language-flag" aria-hidden="true">{{flag}}</span></a>
            {{/site.language_options}}
        </nav>
        <div class="home-hero">
            <p class="home-logo">
                <img src="{{baseUrl}}/images/logo.png" alt="Mujumsoft logo" title="Mujumsoft">
            </p>
            <p class="eyebrow">Mujumsoft</p>
            <h1>{{page.home_heading}}</h1>
            <p class="home-intro">{{page.home_intro}}</p>
            <p class="home-lead">{{page.home_lead}}</p>
            <a class="contact-link" href="mailto:{{site.contact.email}}">{{site.contact.email}} <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</div>

{{/main}}
{{/html}}
